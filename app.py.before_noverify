 CREATE TABLE IF NOT EXISTS deposits(id INTEGER PRIMARY KEY AUTOINCREMENT,user_id INTEGER,amount INTEGER,provider TEXT,reference TEXT,status TEXT DEFAULT 'pending',created_at TEXT);
 CREATE TABLE IF NOT EXISTS withdrawals(id INTEGER PRIMARY KEY AUTOINCREMENT,user_id INTEGER,amount INTEGER,status TEXT DEFAULT 'pending',created_at TEXT,destination TEXT,destination_number TEXT,account_name TEXT);
 CREATE TABLE IF NOT EXISTS transactions(id INTEGER PRIMARY KEY AUTOINCREMENT,user_id INTEGER,kind TEXT,amount INTEGER,note TEXT,created_at TEXT);
 """)
 if not c.execute("SELECT 1 FROM users WHERE email='admin@novaearn.test'").fetchone():
  c.execute("INSERT INTO users(name,email,password,created_at) VALUES(?,?,?,?)",
  ("NovaEarn Admin","admin@novaearn.test",hp("Admin123!"),datetime.now().isoformat()))
 c.commit();c.close()

