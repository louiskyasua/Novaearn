@app.route("/register",methods=["GET","POST"])
def register():
 if request.method=="POST":
  n=request.form["name"].strip();e=request.form["email"].strip().lower();p=request.form["password"]
  if len(p)<8:flash("Password must be at least 8 characters.");return redirect(url_for("register"))
  c=db()
  try:
   cur=c.execute("INSERT INTO users(name,email,password,created_at) VALUES(?,?,?,?)",(n,e,hp(p),datetime.now().isoformat()))
   c.commit();session["uid"]=cur.lastrowid;session["name"]=n;return redirect(url_for("dashboard"))
  except sqlite3.IntegrityError:flash("Email already registered.")
  finally:c.close()
 return render_template("auth.html",mode="register")

